# Public address of the site. Sets the canonical link, social cards and structured data.
# Include the trailing slash. Defaults to the GitHub Pages address.
VITE_SITE_URL=https://bizstatsai.github.io/profile/

# Path the site is served under. The deploy workflow chooses this; set it only for a local build.
VITE_BASE=/profile/

# Optional. Sends the contact form through Formspree. Without it, the form opens an email draft.
VITE_FORMSPREE_ENDPOINT=
